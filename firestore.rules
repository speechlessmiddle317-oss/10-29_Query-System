rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔒 ARCHITECTURE DIRECTIVE:
    // Frontend -> Express API -> SQL Server (Primary Data) -> Firestore (Server-side Sync/Disaster Recovery)
    // Direct client-side writes from the browser are strictly FORBIDDEN.
    // All modifications to users, responses, audit logs, and configurations must go through Express API.

    // Allow public read for questionnaires and public trivia if needed
    match /questionnaires/{surveyId} {
      allow read: if true;
      allow write: if false;
    }

    match /trivia_questions/{triviaId} {
      allow read: if true;
      allow write: if false;
    }

    match /site_update_logs/{logId} {
      allow read: if true;
      allow write: if false;
    }

    // Sensitive collections: Deny all client-side writes
    match /users/{userId} {
      allow read: if false;
      allow write: if false;
    }

    match /responses/{responseId} {
      allow read: if false;
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if false;
      allow write: if false;
    }

    match /promotions/{promoId} {
      allow read: if false;
      allow write: if false;
    }

    match /cheat_reports/{reportId} {
      allow read: if false;
      allow write: if false;
    }

    match /quota_requests/{reqId} {
      allow read: if false;
      allow write: if false;
    }

    // Default fallback: Deny all writes by default
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}


